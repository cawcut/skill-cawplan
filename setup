#!/usr/bin/env bash
# flow-cawplan-skill setup — install skills for Claude Code, Cursor, Codex, etc.
# The installer lives in setup.mjs so the same code runs on Windows
# (`node setup.mjs`). Run ./setup --help for options.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v node &>/dev/null; then
  echo "✗ Node.js >= 22.13 is required to run setup (https://nodejs.org)." >&2
  exit 1
fi
exec node "${ROOT}/setup.mjs" "$@"
