      "skills": [
        "cawplan-requirement-analyze",
        "cawplan-testpoint-generate",
        "cawplan-testcase-generate",
        "cawplan-testcase-import",
        "cawplan-testplan-layout",
        "cawplan-testrail-link",
        "cawplan-defect-ticket",
        "cawplan-test-execution-progress",
